rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own data. Usage counters are written by the function only.
    match /users/{uid}/trips/{tripId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'deleted'])
        && request.resource.data.json is string && request.resource.data.json.size() < 900000;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
